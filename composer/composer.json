{
    "name": "cviniciussdias/buscador-cursos",
    "description": "Projeto que busca os cursos no site da Alura",
    "type": "library",
    "authors": [
        {
            "name": "Vinicius Dias",
            "email": "carlosv775@gmail.com"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^6.3",
        "symfony/dom-crawler": "^4.2",
        "symfony/css-selector": "^4.2"
    },
    "autoload": {
        "files": [
            "./functions.php"
        ],
        "psr-4": {
            "Alura\\BuscadorDeCursos\\": "src/"
        }     
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "squizlabs/php_codesniffer": "^4.0",
        "phan/phan": "^6.0"
    },
    "scripts": {
        "testes": "phpunit tests\\TestBuscadorDeCursos.php",
        "cs": "phpcs --standard=PSR12 src",
        "phan": "phan --allow-polyfill-parser src",
        "check": [
            "@testes",
            "@cs",
            "@phan"
        ],
        "clear-directory": "rmdir /s /q build",
        "post-update-cmd": [
            "@testes"
        ]
    },
    "scripts-descriptions": {
        "check": "Executa as validações do código",
        "clear-directory": "Limpa o diretório de build"
    }
}
